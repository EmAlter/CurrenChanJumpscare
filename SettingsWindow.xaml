<Window x:Class="CurrenChanJumpscare.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jumpscare Settings" Height="350" Width="300" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="20">
        <TextBlock Text="Curren-Chan will pop up unexpectedly at a random moment calculated each time between the minimum and maximum values indicated." 
                   TextWrapping="Wrap" FontStyle="Italic" Foreground="DimGray" Margin="0,0,0,15" />

        <TextBlock Text="Minimum time (seconds):" />
        <TextBox x:Name="MinTimeTextBox" Text="600" Margin="0,5,0,15" />
        
        <TextBlock Text="Maximum time (seconds):" />
        <TextBox x:Name="MaxTimeTextBox" Text="7200" Margin="0,5,0,25" />

        <CheckBox x:Name="AudioCheckBox" Content="Enable Audio" IsChecked="True" Margin="0,0,0,25" />
        
        <Button Content="Start in Background" Click="StartButton_Click" Padding="10" />
    </StackPanel>
</Window>